-- Cached catalog (artists/albums/playlists/tracks) plus per-track parent ordering.
-- Each entity table mirrors the corresponding kotlin data class in com.phoebe.app.domain.

CREATE TABLE ArtistRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    thumbUrl TEXT,
    albumCount INTEGER NOT NULL DEFAULT 0,
    songCount INTEGER NOT NULL DEFAULT 0,
    sortKey INTEGER NOT NULL DEFAULT 0,
    dateAddedMs INTEGER,
    genre TEXT,
    mood TEXT,
    style TEXT,
    rating REAL,
    favorite INTEGER NOT NULL DEFAULT 0,
    biography TEXT
);

CREATE TABLE AlbumRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artist TEXT NOT NULL,
    albumArtist TEXT,
    year INTEGER,
    thumbUrl TEXT,
    sortKey INTEGER NOT NULL DEFAULT 0,
    dateAddedMs INTEGER,
    genre TEXT,
    mood TEXT,
    style TEXT,
    rating REAL,
    favorite INTEGER NOT NULL DEFAULT 0,
    description TEXT,
    recordLabel TEXT,
    releaseDate TEXT
);

CREATE TABLE PlaylistRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    trackCount INTEGER NOT NULL,
    plKey TEXT,
    thumbUrl TEXT,
    sortKey INTEGER NOT NULL DEFAULT 0,
    rating REAL,
    favorite INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE TrackRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artist TEXT NOT NULL,
    album TEXT NOT NULL,
    albumArtist TEXT,
    composer TEXT,
    durationMs INTEGER NOT NULL,
    streamUrl TEXT NOT NULL,
    downloadUrl TEXT NOT NULL,
    thumbUrl TEXT,
    localArtworkUri TEXT,
    localUri TEXT,
    year INTEGER,
    genre TEXT,
    mood TEXT,
    style TEXT,
    filepath TEXT,
    audioCodec TEXT,
    bitrateKbps INTEGER,
    sampleRateHz INTEGER,
    bitDepth INTEGER,
    channelCount INTEGER,
    trackNumber INTEGER,
    discNumber INTEGER,
    bpm INTEGER,
    replayGainTrackGainDb REAL,
    replayGainTrackPeak REAL,
    replayGainAlbumGainDb REAL,
    replayGainAlbumPeak REAL,
    musicBrainzTrackId TEXT,
    musicBrainzReleaseId TEXT,
    comments TEXT,
    explicit INTEGER,
    titleSort TEXT,
    artistSort TEXT,
    albumSort TEXT,
    dateAddedMs INTEGER,
    rating REAL,
    parentAlbumId TEXT
);

CREATE TABLE TrackParentRow (
    parentId TEXT NOT NULL,
    trackId TEXT NOT NULL,
    position INTEGER NOT NULL,
    playlistItemId INTEGER,
    PRIMARY KEY (parentId, position)
);

CREATE INDEX TrackParentRow_parent_position ON TrackParentRow(parentId, position);

CREATE TABLE LibraryPopularTrackRow (
    libraryKey TEXT NOT NULL,
    trackId TEXT NOT NULL,
    position INTEGER NOT NULL,
    updatedAtMs INTEGER NOT NULL,
    PRIMARY KEY (libraryKey, position)
);

CREATE INDEX LibraryPopularTrackRow_library_position ON LibraryPopularTrackRow(libraryKey, position);

CREATE TABLE CollectionTagRow (
    target TEXT NOT NULL,
    facet TEXT NOT NULL,
    itemId TEXT NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY (target, facet, itemId, value)
);

CREATE TABLE CollectionValueRow (
    target TEXT NOT NULL,
    facet TEXT NOT NULL,
    value TEXT NOT NULL,
    key TEXT NOT NULL,
    fastKey TEXT,
    filterField TEXT,
    itemsLoaded INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (target, facet, value)
);

CREATE TABLE CollectionValueLoadRow (
    target TEXT NOT NULL,
    facet TEXT NOT NULL,
    PRIMARY KEY (target, facet)
);

CREATE TABLE LocalFileMetadataCacheRow (
    folderId TEXT NOT NULL,
    uri TEXT NOT NULL,
    sizeBytes INTEGER NOT NULL,
    modifiedAtMs INTEGER NOT NULL,
    trackId TEXT NOT NULL,
    albumId TEXT NOT NULL,
    title TEXT NOT NULL,
    artist TEXT NOT NULL,
    album TEXT NOT NULL,
    albumArtist TEXT,
    composer TEXT,
    durationMs INTEGER NOT NULL,
    year INTEGER,
    genre TEXT,
    mood TEXT,
    style TEXT,
    bitrateKbps INTEGER,
    sampleRateHz INTEGER,
    bitDepth INTEGER,
    channelCount INTEGER,
    trackNumber INTEGER,
    discNumber INTEGER,
    bpm INTEGER,
    replayGainTrackGainDb REAL,
    replayGainTrackPeak REAL,
    replayGainAlbumGainDb REAL,
    replayGainAlbumPeak REAL,
    musicBrainzTrackId TEXT,
    musicBrainzReleaseId TEXT,
    comments TEXT,
    explicit INTEGER,
    titleSort TEXT,
    artistSort TEXT,
    albumSort TEXT,
    audioCodec TEXT,
    filepath TEXT,
    localArtworkUri TEXT,
    dateAddedMs INTEGER NOT NULL,
    PRIMARY KEY (folderId, uri)
);

selectArtists:
SELECT * FROM ArtistRow ORDER BY sortKey, title COLLATE NOCASE;

selectAlbums:
SELECT * FROM AlbumRow ORDER BY sortKey, title COLLATE NOCASE;

selectPlaylists:
SELECT * FROM PlaylistRow ORDER BY sortKey, title COLLATE NOCASE;

selectAllTracks:
SELECT * FROM TrackRow;

selectTrackById:
SELECT * FROM TrackRow WHERE id = ? LIMIT 1;

selectTracksByIds:
SELECT * FROM TrackRow WHERE id IN :ids;

selectTrackDateAddedForIds:
SELECT id, dateAddedMs FROM TrackRow WHERE id IN :ids;

selectTrackParents:
SELECT parentId, trackId, position, playlistItemId FROM TrackParentRow ORDER BY parentId, position;

selectLibraryPopularTracks:
SELECT * FROM LibraryPopularTrackRow ORDER BY libraryKey, position;

selectPopularTracksForLibrary:
SELECT t.*
FROM TrackRow t
INNER JOIN LibraryPopularTrackRow p ON p.trackId = t.id
WHERE p.libraryKey = ?
ORDER BY p.position;

selectCollectionTags:
SELECT * FROM CollectionTagRow;

selectCollectionValues:
SELECT * FROM CollectionValueRow;

selectCollectionValueLoads:
SELECT * FROM CollectionValueLoadRow;

selectTracksForParent:
SELECT t.*
FROM TrackRow t
INNER JOIN TrackParentRow tp ON tp.trackId = t.id
WHERE tp.parentId = ?
ORDER BY tp.position;

selectAllTrackIds:
SELECT id FROM TrackRow;

deleteTrackById:
DELETE FROM TrackRow WHERE id = ?;

deleteTrackParentsForParent:
DELETE FROM TrackParentRow WHERE parentId = ?;

deleteArtistById:
DELETE FROM ArtistRow WHERE id = ?;

deleteAlbumById:
DELETE FROM AlbumRow WHERE id = ?;

deletePlaylistById:
DELETE FROM PlaylistRow WHERE id = ?;

upsertArtist:
INSERT OR REPLACE INTO ArtistRow(id, title, thumbUrl, albumCount, songCount, sortKey, dateAddedMs, genre, mood, style, rating, favorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertAlbum:
INSERT OR REPLACE INTO AlbumRow(id, title, artist, year, thumbUrl, sortKey, dateAddedMs, genre, mood, style, rating, favorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertAlbumFull:
INSERT OR REPLACE INTO AlbumRow(
    id, title, artist, albumArtist, year, thumbUrl, sortKey, dateAddedMs, genre, mood, style, rating, favorite, description, recordLabel, releaseDate
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAlbumMetadata:
UPDATE AlbumRow
SET mood = ?,
    style = ?,
    description = ?,
    recordLabel = ?,
    releaseDate = ?
WHERE id = ?;

upsertPlaylist:
INSERT OR REPLACE INTO PlaylistRow(id, title, trackCount, plKey, thumbUrl, sortKey, rating, favorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

upsertTrack:
INSERT OR REPLACE INTO TrackRow(
    id, title, artist, album, durationMs, streamUrl, downloadUrl,
    thumbUrl, localArtworkUri, localUri, year, genre, mood, style, filepath, audioCodec, bitrateKbps, dateAddedMs, rating, parentAlbumId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertTrackParent:
INSERT OR REPLACE INTO TrackParentRow(parentId, trackId, position, playlistItemId) VALUES (?, ?, ?, ?);

upsertLibraryPopularTrack:
INSERT OR REPLACE INTO LibraryPopularTrackRow(libraryKey, trackId, position, updatedAtMs) VALUES (?, ?, ?, ?);

upsertCollectionTag:
INSERT OR REPLACE INTO CollectionTagRow(target, facet, itemId, value) VALUES (?, ?, ?, ?);

upsertCollectionValue:
INSERT OR REPLACE INTO CollectionValueRow(target, facet, value, key, fastKey, filterField, itemsLoaded) VALUES (?, ?, ?, ?, ?, ?, ?);

upsertCollectionValueLoad:
INSERT OR REPLACE INTO CollectionValueLoadRow(target, facet) VALUES (?, ?);

deleteTrackParents:
DELETE FROM TrackParentRow WHERE parentId = ?;

deleteLibraryPopularTracksForLibrary:
DELETE FROM LibraryPopularTrackRow WHERE libraryKey = ?;

clearLibraryPopularTracks:
DELETE FROM LibraryPopularTrackRow;

clearCollectionTags:
DELETE FROM CollectionTagRow;

clearCollectionValues:
DELETE FROM CollectionValueRow;

clearCollectionValueLoads:
DELETE FROM CollectionValueLoadRow;

clearArtists:
DELETE FROM ArtistRow;

clearAlbums:
DELETE FROM AlbumRow;

clearPlaylists:
DELETE FROM PlaylistRow;

clearTracks:
DELETE FROM TrackRow;

clearTrackParents:
DELETE FROM TrackParentRow;

clearLocalFileMetadataCache:
DELETE FROM LocalFileMetadataCacheRow;

selectLocalFileMetadataCacheForFolder:
SELECT * FROM LocalFileMetadataCacheRow WHERE folderId = ?;

upsertLocalFileMetadataCache:
INSERT OR REPLACE INTO LocalFileMetadataCacheRow(
    folderId, uri, sizeBytes, modifiedAtMs, trackId, albumId, title, artist,
    album, durationMs, year, genre, mood, style, bitrateKbps, audioCodec, filepath, localArtworkUri, dateAddedMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteLocalFileMetadataCache:
DELETE FROM LocalFileMetadataCacheRow WHERE folderId = ? AND uri = ?;

clearLocalFileMetadataCacheForFolder:
DELETE FROM LocalFileMetadataCacheRow WHERE folderId = ?;
