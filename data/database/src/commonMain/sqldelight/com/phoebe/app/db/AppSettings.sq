-- Single-row table: holds app-wide settings that are not specific to library layout.

CREATE TABLE AppSettingsRow (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1) DEFAULT 1,
    crossfadeSeconds INTEGER NOT NULL DEFAULT 0,
    scanLibraryOnLaunch INTEGER NOT NULL DEFAULT 0,
    notifyWhenDownloadFinishes INTEGER NOT NULL DEFAULT 0,
    keepPlayingEnabled INTEGER NOT NULL DEFAULT 0,
    persistEqualizerSettings INTEGER NOT NULL DEFAULT 0,
    persistVolumeSettings INTEGER NOT NULL DEFAULT 0,
    savedVolume REAL NOT NULL DEFAULT 0.7,
    equalizerProfile TEXT NOT NULL DEFAULT '{"enabled":false,"bandCount":10,"gainsDb":[]}',
    nowPlayingVisualizerPreset TEXT NOT NULL DEFAULT 'Artwork',
    nowPlayingVisualizerInTvFrame INTEGER NOT NULL DEFAULT 0,
    blurredArtworkAppearance INTEGER NOT NULL DEFAULT 1,
    fullBleedDetailArtwork INTEGER NOT NULL DEFAULT 1,
    tintedBackgroundGradient INTEGER NOT NULL DEFAULT 1,
    listenBrainzSettings TEXT NOT NULL DEFAULT '{"enabled":false,"username":null,"submitNowPlaying":true,"submitListens":true,"submitCurrentTrackFeedback":true,"storageStatus":"Unknown","connectedAtMs":null,"lastValidatedAtMs":null,"lastSubmittedAtMs":null,"lastNowPlayingSubmittedAtMs":null,"lastListenSubmittedAtMs":null,"lastListenError":null,"lastError":null}',
    lastFmSettings TEXT NOT NULL DEFAULT '{"enabled":false,"username":null,"apiKey":null,"submitNowPlaying":true,"submitScrobbles":true,"storageStatus":"Unknown","connectedAtMs":null,"lastValidatedAtMs":null,"lastSubmittedAtMs":null,"lastNowPlayingSubmittedAtMs":null,"lastScrobbleSubmittedAtMs":null,"lastScrobbleError":null,"lastError":null}',
    downloadPolicySettings TEXT NOT NULL DEFAULT '{"quality":"Original","maxConcurrentDownloads":3,"autoRetryFailedDownloads":true,"wifiOnly":false,"wifiOnlyConfigured":false,"notifyOnCompletion":true}',
    audioProcessingSettings TEXT NOT NULL DEFAULT '{"gaplessEnabled":true,"crossfeedEnabled":false,"crossfeedAmount":0.35,"selectedOutputDeviceId":null,"exclusiveMode":false,"bitPerfectPreference":false}'
);

selectCurrent:
SELECT * FROM AppSettingsRow WHERE id = 1;

upsert:
INSERT OR REPLACE INTO AppSettingsRow(
    id,
    crossfadeSeconds,
    scanLibraryOnLaunch,
    notifyWhenDownloadFinishes,
    keepPlayingEnabled,
    persistEqualizerSettings,
    persistVolumeSettings,
    savedVolume,
    equalizerProfile,
    nowPlayingVisualizerPreset,
    nowPlayingVisualizerInTvFrame,
    blurredArtworkAppearance,
    fullBleedDetailArtwork,
    tintedBackgroundGradient,
    listenBrainzSettings,
    lastFmSettings,
    downloadPolicySettings,
    audioProcessingSettings
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clear:
DELETE FROM AppSettingsRow;
