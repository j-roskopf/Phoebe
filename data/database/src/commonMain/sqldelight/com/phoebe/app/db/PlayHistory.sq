-- Per-play history. Each call to recordPlay inserts a fresh row, so a track can
-- appear many times. UI surfaces use the MAX(played_at_ms) per scope (track,
-- album, artist) for "last played".

CREATE TABLE PlayHistoryRow (
    track_id TEXT NOT NULL,
    artist TEXT NOT NULL,
    album TEXT NOT NULL,
    played_at_ms INTEGER NOT NULL,
    source TEXT NOT NULL DEFAULT 'local',
    plex_server_id TEXT,
    plex_history_key TEXT,
    plex_imported_at_ms INTEGER
);

CREATE INDEX play_history_artist_idx ON PlayHistoryRow(artist);
CREATE INDEX play_history_album_idx ON PlayHistoryRow(album);
CREATE INDEX play_history_track_idx ON PlayHistoryRow(track_id);
CREATE INDEX play_history_played_at_idx ON PlayHistoryRow(played_at_ms);
CREATE UNIQUE INDEX play_history_plex_history_key_idx ON PlayHistoryRow(plex_history_key)
WHERE plex_history_key IS NOT NULL;

CREATE TABLE PlayCountAggregateRow (
    track_id TEXT NOT NULL PRIMARY KEY,
    artist TEXT NOT NULL,
    album TEXT NOT NULL,
    play_count INTEGER NOT NULL,
    last_played_at_ms INTEGER NOT NULL,
    source TEXT NOT NULL,
    server_id TEXT NOT NULL,
    imported_at_ms INTEGER NOT NULL
);

CREATE INDEX play_count_aggregate_source_idx ON PlayCountAggregateRow(source, server_id);

recordPlay:
INSERT INTO PlayHistoryRow(track_id, artist, album, played_at_ms)
VALUES (?, ?, ?, ?);

insertImportedPlexPlay:
INSERT OR IGNORE INTO PlayHistoryRow(
    track_id,
    artist,
    album,
    played_at_ms,
    source,
    plex_server_id,
    plex_history_key,
    plex_imported_at_ms
)
VALUES (?, ?, ?, ?, 'plex', ?, ?, ?);

insertImportedRemotePlay:
INSERT OR IGNORE INTO PlayHistoryRow(
    track_id,
    artist,
    album,
    played_at_ms,
    source,
    plex_server_id,
    plex_history_key,
    plex_imported_at_ms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectMaxImportedPlexPlayedAt:
SELECT MAX(played_at_ms) AS lastPlayed
FROM PlayHistoryRow
WHERE source = 'plex'
AND plex_server_id = ?;

selectMaxImportedRemotePlayedAt:
SELECT MAX(played_at_ms) AS lastPlayed
FROM PlayHistoryRow
WHERE source = ?
AND plex_server_id = ?;

selectMaxImportedRemoteStatsLastPlayedAt:
SELECT MAX(last_played_at_ms) AS lastPlayed
FROM PlayCountAggregateRow
WHERE source = ?
AND server_id = ?;

selectMaxPlexStatsLastPlayedAt:
SELECT MAX(last_played_at_ms) AS lastPlayed
FROM PlayCountAggregateRow
WHERE source = 'plex-stats'
AND server_id = ?;

selectImportedPlexHistoryKey:
SELECT plex_history_key
FROM PlayHistoryRow
WHERE plex_history_key = ?
LIMIT 1;

selectLocalMergeCandidate:
SELECT played_at_ms
FROM PlayHistoryRow
WHERE track_id = ?
AND source = 'local'
AND plex_history_key IS NULL
AND played_at_ms BETWEEN ? AND ?
ORDER BY played_at_ms DESC
LIMIT 1;

markLocalPlayAsImportedPlex:
UPDATE PlayHistoryRow
SET played_at_ms = ?,
    source = 'plex',
    plex_server_id = ?,
    plex_history_key = ?,
    plex_imported_at_ms = ?
WHERE track_id = ?
AND played_at_ms = ?
AND source = 'local'
AND plex_history_key IS NULL;

markLocalPlayAsImportedRemote:
UPDATE PlayHistoryRow
SET played_at_ms = ?,
    source = ?,
    plex_server_id = ?,
    plex_history_key = ?,
    plex_imported_at_ms = ?
WHERE track_id = ?
AND played_at_ms = ?
AND source = 'local'
AND plex_history_key IS NULL;

selectLastPlayedByArtist:
SELECT artist, MAX(lastPlayed) AS lastPlayed
FROM (
    SELECT artist, played_at_ms AS lastPlayed
    FROM PlayHistoryRow
    UNION ALL
    SELECT artist, last_played_at_ms AS lastPlayed
    FROM PlayCountAggregateRow
    WHERE last_played_at_ms > 0
)
GROUP BY artist;

selectLastPlayedByAlbum:
SELECT album, MAX(lastPlayed) AS lastPlayed
FROM (
    SELECT album, played_at_ms AS lastPlayed
    FROM PlayHistoryRow
    UNION ALL
    SELECT album, last_played_at_ms AS lastPlayed
    FROM PlayCountAggregateRow
    WHERE last_played_at_ms > 0
)
GROUP BY album;

selectLastPlayedByTrack:
SELECT track_id, MAX(lastPlayed) AS lastPlayed
FROM (
    SELECT track_id, played_at_ms AS lastPlayed
    FROM PlayHistoryRow
    UNION ALL
    SELECT track_id, last_played_at_ms AS lastPlayed
    FROM PlayCountAggregateRow
    WHERE last_played_at_ms > 0
)
GROUP BY track_id;

selectPlayCountsByTrack:
WITH event_counts AS (
    SELECT track_id, COUNT(*) AS playCount
    FROM PlayHistoryRow
    GROUP BY track_id
),
aggregate_counts AS (
    SELECT
        aggregate.track_id,
        aggregate.play_count + (
            SELECT COUNT(*)
            FROM PlayHistoryRow local_play
            WHERE local_play.track_id = aggregate.track_id
            AND local_play.played_at_ms > aggregate.last_played_at_ms
        ) AS playCount
    FROM PlayCountAggregateRow aggregate
)
SELECT track_id, MAX(playCount) AS playCount
FROM (
    SELECT track_id, playCount
    FROM event_counts
    UNION ALL
    SELECT track_id, playCount
    FROM aggregate_counts
)
GROUP BY track_id;

selectPlayCountAggregateByTrack:
SELECT *
FROM PlayCountAggregateRow
WHERE track_id = ?
LIMIT 1;

insertPlayCountAggregate:
INSERT OR REPLACE INTO PlayCountAggregateRow(
    track_id,
    artist,
    album,
    play_count,
    last_played_at_ms,
    source,
    server_id,
    imported_at_ms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectTopMostPlayedByTrack:
WITH play_counts AS (
    SELECT track_id, MAX(playCount) AS playCount
    FROM (
        SELECT track_id, COUNT(*) AS playCount
        FROM PlayHistoryRow
        GROUP BY track_id
        UNION ALL
        SELECT
            aggregate.track_id,
            aggregate.play_count + (
                SELECT COUNT(*)
                FROM PlayHistoryRow local_play
                WHERE local_play.track_id = aggregate.track_id
                AND local_play.played_at_ms > aggregate.last_played_at_ms
            ) AS playCount
        FROM PlayCountAggregateRow aggregate
    )
    GROUP BY track_id
    HAVING playCount > 0
)
SELECT
    play_counts.track_id,
    play_counts.playCount,
    COALESCE(
        (SELECT MAX(played_at_ms) FROM PlayHistoryRow p WHERE p.track_id = play_counts.track_id),
        (SELECT last_played_at_ms FROM PlayCountAggregateRow a WHERE a.track_id = play_counts.track_id),
        0
    ) AS lastPlayedMs,
    COALESCE(
        (SELECT artist FROM PlayHistoryRow p WHERE p.track_id = play_counts.track_id ORDER BY played_at_ms DESC LIMIT 1),
        (SELECT artist FROM PlayCountAggregateRow a WHERE a.track_id = play_counts.track_id),
        ''
    ) AS artist,
    COALESCE(
        (SELECT album FROM PlayHistoryRow p WHERE p.track_id = play_counts.track_id ORDER BY played_at_ms DESC LIMIT 1),
        (SELECT album FROM PlayCountAggregateRow a WHERE a.track_id = play_counts.track_id),
        ''
    ) AS album
FROM play_counts
ORDER BY play_counts.playCount DESC, lastPlayedMs DESC, play_counts.track_id
LIMIT ?;

selectMostPlayedArtistCounts:
WITH track_counts AS (
    SELECT track_id, MAX(playCount) AS playCount
    FROM (
        SELECT track_id, COUNT(*) AS playCount
        FROM PlayHistoryRow
        GROUP BY track_id
        UNION ALL
        SELECT
            aggregate.track_id,
            aggregate.play_count + (
                SELECT COUNT(*)
                FROM PlayHistoryRow local_play
                WHERE local_play.track_id = aggregate.track_id
                AND local_play.played_at_ms > aggregate.last_played_at_ms
            ) AS playCount
        FROM PlayCountAggregateRow aggregate
    )
    GROUP BY track_id
    HAVING playCount > 0
),
track_rows AS (
    SELECT
        track_counts.track_id,
        track_counts.playCount,
        COALESCE(
            (SELECT artist FROM PlayHistoryRow p WHERE p.track_id = track_counts.track_id ORDER BY played_at_ms DESC LIMIT 1),
            (SELECT artist FROM PlayCountAggregateRow a WHERE a.track_id = track_counts.track_id),
            ''
        ) AS artist,
        COALESCE(
            (SELECT MAX(played_at_ms) FROM PlayHistoryRow p WHERE p.track_id = track_counts.track_id),
            (SELECT last_played_at_ms FROM PlayCountAggregateRow a WHERE a.track_id = track_counts.track_id),
            0
        ) AS lastPlayedMs
    FROM track_counts
)
SELECT
    artist,
    CAST(SUM(playCount) AS INTEGER) AS playCount,
    MAX(lastPlayedMs) AS lastPlayedMs,
    COUNT(*) AS trackCount
FROM track_rows
WHERE artist != ''
GROUP BY artist
ORDER BY playCount DESC, lastPlayedMs DESC, artist
LIMIT ?;

selectMostPlayedTrackCount:
WITH play_counts AS (
    SELECT track_id, MAX(playCount) AS playCount
    FROM (
        SELECT track_id, COUNT(*) AS playCount
        FROM PlayHistoryRow
        GROUP BY track_id
        UNION ALL
        SELECT
            aggregate.track_id,
            aggregate.play_count + (
                SELECT COUNT(*)
                FROM PlayHistoryRow local_play
                WHERE local_play.track_id = aggregate.track_id
                AND local_play.played_at_ms > aggregate.last_played_at_ms
            ) AS playCount
        FROM PlayCountAggregateRow aggregate
    )
    GROUP BY track_id
    HAVING playCount > 0
)
SELECT COUNT(*) AS totalCount
FROM play_counts;

selectTopRecentlyPlayedByTrack:
WITH last_played AS (
    SELECT track_id, played_at_ms AS lastPlayedMs, artist, album
    FROM PlayHistoryRow
    UNION ALL
    SELECT track_id, last_played_at_ms AS lastPlayedMs, artist, album
    FROM PlayCountAggregateRow
    WHERE last_played_at_ms > 0
)
SELECT
    track_id,
    MAX(lastPlayedMs) AS lastPlayedMs,
    COALESCE(
        (SELECT artist FROM last_played lp2 WHERE lp2.track_id = lp1.track_id ORDER BY lastPlayedMs DESC LIMIT 1),
        ''
    ) AS artist,
    COALESCE(
        (SELECT album FROM last_played lp2 WHERE lp2.track_id = lp1.track_id ORDER BY lastPlayedMs DESC LIMIT 1),
        ''
    ) AS album
FROM last_played lp1
GROUP BY track_id
ORDER BY lastPlayedMs DESC, track_id
LIMIT ?;

selectRecentlyPlayedTrackCount:
WITH last_played AS (
    SELECT track_id, played_at_ms AS lastPlayedMs
    FROM PlayHistoryRow
    UNION ALL
    SELECT track_id, last_played_at_ms AS lastPlayedMs
    FROM PlayCountAggregateRow
    WHERE last_played_at_ms > 0
)
SELECT COUNT(DISTINCT track_id) AS totalCount
FROM last_played;

selectLatestPlayEventsByTrack:
SELECT track_id, played_at_ms
FROM PlayHistoryRow
ORDER BY played_at_ms DESC
LIMIT 2000;

clearAll:
DELETE FROM PlayHistoryRow;

clearAllAggregates:
DELETE FROM PlayCountAggregateRow;
