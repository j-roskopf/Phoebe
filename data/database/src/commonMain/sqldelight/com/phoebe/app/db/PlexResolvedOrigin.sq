-- Working Plex API/media base per physical network. Survives process death so off-LAN /
-- cellular cold starts can prefer the last-good relay (as a race hint) instead of burning
-- the first race on a dead LAN or closed public :32400 hop from the previous session.

CREATE TABLE PlexResolvedOriginRow (
    serverId TEXT NOT NULL,
    networkFingerprint TEXT NOT NULL,
    origin TEXT NOT NULL,
    updatedAtMs INTEGER NOT NULL,
    PRIMARY KEY (serverId, networkFingerprint)
);

selectOrigin:
SELECT origin
FROM PlexResolvedOriginRow
WHERE serverId = ? AND networkFingerprint = ?;

upsertOrigin:
INSERT OR REPLACE INTO PlexResolvedOriginRow(serverId, networkFingerprint, origin, updatedAtMs)
VALUES (?, ?, ?, ?);

deleteForServer:
DELETE FROM PlexResolvedOriginRow WHERE serverId = ?;

deleteOrigin:
DELETE FROM PlexResolvedOriginRow
WHERE serverId = ? AND networkFingerprint = ? AND origin = ?;

clearAll:
DELETE FROM PlexResolvedOriginRow;
