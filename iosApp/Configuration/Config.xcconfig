TEAM_ID=LVCF4PVSY3
BUNDLE_ID=com.joetr.phoebe
APP_NAME=Phoebe

// Compose Multiplatform 1.11+ uses UIViewLayoutRegion (iOS 26 SDK). Requires Xcode 26+ to build.
IPHONEOS_DEPLOYMENT_TARGET = 26.0

EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386 x86_64
ARCHS[sdk=iphonesimulator*] = arm64

// libprojectM static installs from scripts/build-projectm.sh ios-sim / ios-device.
LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/../native/projectm/ios-sim/lib
LIBRARY_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/../native/projectm/ios-device/lib
HEADER_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/../native/projectm/ios-sim/include
HEADER_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/../native/projectm/ios-device/include
OTHER_LDFLAGS = $(inherited) -lprojectM-4 -lc++ -framework OpenGLES -framework GLKit -framework CoreVideo
SWIFT_OBJC_BRIDGING_HEADER = iosApp/iosApp-Bridging-Header.h
